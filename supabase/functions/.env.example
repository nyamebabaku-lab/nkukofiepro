# ─────────────────────────────────────────────────────────────────────────────
#  PoultryPro SMS settings (mNotify) — PRIVATE. This file is never published.
#  Fill in the two values below, save, and tell Claude "SMS env ready".
# ─────────────────────────────────────────────────────────────────────────────

# Your mNotify API key (mNotify dashboard → API → API Key / "Quick SMS API key")
MNOTIFY_API_KEY=

# Your approved mNotify Sender ID (max 11 letters, e.g. PoultryPro).
# It must be registered and approved in your mNotify account first.
MNOTIFY_SENDER_ID=

# Safety limit: most SMS one farm business can send per day (stops runaway costs).
MNOTIFY_DAILY_LIMIT=300
